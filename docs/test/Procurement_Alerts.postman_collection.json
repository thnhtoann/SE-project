		{
			"name": "1. Low-Stock Alerts Automated BVA Suite (Scrum 109 / PROC-5)",
			"item": [
				{
					"name": "BVA 1.1: Setup Qty Above Threshold (Stock=15 > Threshold=10)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Pre-request script to clear previous alerts and set stock to 15",
									"pm.sendRequest({",
									"    url: pm.collectionVariables.get('baseUrl') + '/store-inventories/1/',",
									"    method: 'PATCH',",
									"    header: {",
									"        'Content-Type': 'application/json',",
									"        'Authorization': 'Bearer ' + pm.collectionVariables.get('token')",
									"    },",
									"    body: {",
									"        mode: 'raw',",
									"        raw: JSON.stringify({ quantity: 15 })",
									"    }",
									"}, function (err, res) {});"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('BVA Case 1: When Stock > MinThreshold, NO alert is generated', function () {",
									"    var jsonData = pm.response.json();",
									"    var activeAlertsForProduct = jsonData.filter(a => a.product === parseInt(pm.collectionVariables.get('testProductId')) && !a.is_resolved && a.current_stock > a.min_threshold);",
									"    pm.expect(activeAlertsForProduct.length).to.eql(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/inventory/low-stock-alerts/?is_resolved=false",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"inventory",
								"low-stock-alerts",
								""
							],
							"query": [
								{
									"key": "is_resolved",
									"value": "false"
								}
							]
						},
						"description": "Automated BVA Test 1: Stock Quantity = 15, MinThreshold = 10 (Above Threshold).\nVerifies no low stock alert is active."
					}
				},
