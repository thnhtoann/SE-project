{
	"info": {
		"_postman_id": "d3f1a2b4-5e6c-4a7b-9c8d-1f2e3a4b5c6d",
		"name": "M3 - Omnichannel Hub & Forecasting API Collection",
		"description": "Postman collection for Member 3's modules: OMNI-1 (webhooks), OMNI-5 (aggregated order list), and FCST-5 (demand forecast API). Covers webhook signature auth, JWT + RBAC on the forecast/orders endpoints.\n\nNOTE: Login is a 2-step OTP flow (request-otp -> email OTP -> verify-otp). Since EMAIL_BACKEND is the console backend, the OTP is printed to your `docker compose logs -f backend` output, not delivered anywhere Postman can read automatically. You must copy it manually - see the tutorial steps.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "loginUsername",
			"value": "cm_test",
			"type": "string"
		},
		{
			"key": "loginPassword",
			"value": "testpass123",
			"type": "string"
		},
		{
			"key": "loginEmail",
			"value": "cm_test@example.com",
			"type": "string"
		},
		{
			"key": "otpCode",
			"value": "",
			"type": "string"
		},
		{
			"key": "grabmartSecret",
			"value": "dev-grabmart-secret",
			"type": "string"
		},
		{
			"key": "shopeefoodSecret",
			"value": "dev-shopeefood-secret",
			"type": "string"
		},
		{
			"key": "bemartSecret",
			"value": "dev-bemart-secret",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Authentication (2-step OTP)",
			"item": [
				{
					"name": "Step 1: Request OTP (username+password+email)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Response confirms OTP was sent', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('message');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{loginUsername}}\",\n    \"password\": \"{{loginPassword}}\",\n    \"email\": \"{{loginEmail}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/login/request-otp/",
							"host": ["{{baseUrl}}"],
							"path": ["login", "request-otp", ""]
						},
						"description": "Sends username/password/email. On success, an OTP is generated and 'emailed' - but since EMAIL_BACKEND is the console backend, it actually prints to the backend container's logs. Run `docker compose logs -f backend` and copy the 6-digit code into the `otpCode` collection variable before running Step 2."
					}
				},
				{
					"name": "Step 2: Verify OTP -> Get JWT",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access) {",
									"    pm.collectionVariables.set('token', jsonData.access);",
									"}",
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Access token returned and saved', function () {",
									"    pm.expect(jsonData).to.have.property('access');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{loginUsername}}\",\n    \"otp\": \"{{otpCode}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/login/verify-otp/",
							"host": ["{{baseUrl}}"],
							"path": ["login", "verify-otp", ""]
						},
						"description": "Paste the OTP you copied from the backend logs into the `otpCode` variable, then send this. On success the JWT access token is auto-saved into `{{token}}` for use by every request below."
					}
				}
			]
		},
		{
			"name": "1. OMNI-1: Webhook Listeners",
			"item": [
				{
					"name": "GrabMart - Valid Signature",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Response has order_id', function () {",
									"    pm.expect(pm.response.json()).to.have.property('order_id');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-Grab-Signature", "value": "{{grabmartSecret}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"orderId\": \"GM-POSTMAN-001\",\n    \"storeId\": 1,\n    \"orderTime\": \"2026-08-29T09:30:00Z\",\n    \"paymentMethod\": \"GrabPay\",\n    \"items\": [{\"barcode\": \"8934673125456\", \"qty\": 1, \"price\": \"0.90\"}]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/webhooks/grabmart/",
							"host": ["{{baseUrl}}"],
							"path": ["webhooks", "grabmart", ""]
						},
						"description": "Requires a Product with barcode 8934673125456 and Store id=1 to already exist in your DB, or this returns 400."
					}
				},
				{
					"name": "GrabMart - Invalid Signature (expect 401)",
					"event": [
