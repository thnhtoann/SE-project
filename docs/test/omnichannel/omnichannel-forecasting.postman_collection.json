		{
			"name": "2. OMNI-5: Aggregated Order List",
			"item": [
				{
					"name": "List all orders (no filter)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Response is a list', function () {",
									"    pm.expect(pm.response.json()).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/orders/",
							"host": ["{{baseUrl}}"],
							"path": ["orders", ""]
						}
					}
				},
				{
					"name": "List orders filtered by channel=GrabMart",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('All returned orders are GrabMart', function () {",
									"    var jsonData = pm.response.json();",
									"    jsonData.forEach(function (order) {",
									"        pm.expect(order.order_type).to.eql('GrabMart');",
									"    });",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/orders/?channel=GrabMart",
							"host": ["{{baseUrl}}"],
							"path": ["orders", ""],
							"query": [{ "key": "channel", "value": "GrabMart" }]
						}
					}
				},
				{
					"name": "List orders - No token (expect 401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 401 Unauthorized', function () {",
