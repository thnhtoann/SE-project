							"raw": "{{baseUrl}}/orders/",
							"host": ["{{baseUrl}}"],
							"path": ["orders", ""]
						},
						"description": "Deliberately no Authorization header - confirms RBAC blocks unauthenticated access."
					}
				}
			]
		},
		{
