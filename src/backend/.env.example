DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Required in production (DJANGO_DEBUG=0) for Django admin POST requests over
# HTTPS — comma-separated, each entry needs the scheme, e.g.
# https://your-app.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# DATABASE_URL takes priority over the POSTGRES_* vars below when set (the
# single-connection-string form most PaaS Postgres add-ons provide).
DATABASE_URL=
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Omnichannel Webhook Secrets
GRABMART_WEBHOOK_SECRET=dev-grabmart-secret
SHOPEEFOOD_WEBHOOK_SECRET=dev-shopeefood-secret
BEMART_WEBHOOK_SECRET=dev-bemart-secret

# Lazada Open Platform (sandbox or production seller account) — from your
# app's "My Apps" page in the Lazada Open Platform console.
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_API_URL=https://api.lazada.vn/rest
LAZADA_AUTH_URL=https://auth.lazada.com/rest
LAZADA_AUTHORIZE_PAGE_URL=https://auth.lazada.com/oauth/authorize
LAZADA_REDIRECT_URI=http://localhost:8000/api/lazada/callback/
FRONTEND_BASE_URL=http://localhost:3000

# Google AI Studio API key -- powers the revenue-advisor LangGraph agent
# (advisor app): Gemini for insight generation + Grounding with Google
# Search for local market context. Get one at https://aistudio.google.com/
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Identity Services (Sign in with Google) — OAuth 2.0 Client ID
# ("Web application" type) from the Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=

# Facebook Login — App ID/Secret from the app's Settings > Basic page in the
# Facebook Developers console.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# PayOS (VietQR payment gateway, https://payos.vn) — powers the real Bank QR
# checkout in the POS module. Get credentials from a PayOS merchant account:
# Payment channels > <channel> > API keys. After deploying, register your
# webhook URL (<backend-url>/api/pos/webhooks/payos/) via PayOS's "Confirm
# Webhook" dashboard action or API call — PayOS won't call it otherwise.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_API_URL=https://api-merchant.payos.vn

# OTP emails (register/login/password-reset) — leave everything below blank
# to keep OTPs printed to the backend log only (local dev default).
#
# On Railway (Free/Trial/Hobby plans block outbound SMTP entirely), set
# RESEND_API_KEY instead — sign up at resend.com, verify a sending domain,
# create an API key. Works on every plan since it's HTTPS, not SMTP.
RESEND_API_KEY=
#
# Elsewhere (or on Railway Pro+), real SMTP works too, e.g. Gmail with an
# App Password (requires 2FA on the Google account, not your regular
# account password). Ignored if RESEND_API_KEY is set.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@smartprocurement.com

# Temporary testing backdoor -- if set, this code is ALSO accepted (on top
# of the real one) by every OTP-verify endpoint. Use while real OTP email
# delivery is unavailable (e.g. Resend sending domain not yet verified) so
# the team can still test register/login/password-reset flows end-to-end.
# Leave blank normally; unset this in Railway once real delivery works.
OTP_BYPASS_CODE=
