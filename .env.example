# Copy to .env and adjust as needed. .env itself is gitignored.

# Postgres
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password

# Django
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Omnichannel Webhook Secrets
GRABMART_WEBHOOK_SECRET=dev-grabmart-secret
SHOPEEFOOD_WEBHOOK_SECRET=dev-shopeefood-secret
BEMART_WEBHOOK_SECRET=dev-bemart-secret

# Bank QR Payment Webhook Secret
BANK_QR_WEBHOOK_SECRET=dev-bank-qr-secret
