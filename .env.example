# Copy to .env and adjust as needed. .env itself is gitignored.

# Postgres
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password

# Django
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Omnichannel Webhook Secrets
GRABMART_WEBHOOK_SECRET=dev-grabmart-secret
SHOPEEFOOD_WEBHOOK_SECRET=dev-shopeefood-secret
BEMART_WEBHOOK_SECRET=dev-bemart-secret

# Lazada Open Platform (sandbox or production seller account) — from your
# app's "My Apps" page in the Lazada Open Platform console.
LAZADA_APP_KEY=
LAZADA_APP_SECRET=

# Google Identity Services (Sign in with Google) — OAuth 2.0 Client ID
# ("Web application" type) from the Google Cloud Console. Same value is used
# by both backend (token audience check) and frontend (NEXT_PUBLIC_ variant).
GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Facebook Login — App ID/Secret from the app's Settings > Basic page in the
# Facebook Developers console. FACEBOOK_APP_SECRET stays server-side only.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# PayOS (VietQR payment gateway, https://payos.vn) — powers the real Bank QR
# checkout in the POS module. Get credentials from a PayOS merchant account:
# Payment channels > <channel> > API keys. After deploying, register your
# webhook URL (<backend-url>/api/pos/webhooks/payos/) via PayOS's "Confirm
# Webhook" dashboard action or API call — PayOS won't call it otherwise.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# OTP emails (register/login/password-reset) — leave everything below blank
# to keep OTPs printed to the backend log only (local dev default).
#
# On Railway (Free/Trial/Hobby plans block outbound SMTP entirely — see
# docs.railway.com/networking/outbound-networking), set RESEND_API_KEY
# instead: sign up at resend.com, verify a sending domain (or use their
# shared onboarding domain for testing), create an API key. Works on every
# plan since it's HTTPS, not SMTP.
RESEND_API_KEY=
#
# Elsewhere (or on Railway Pro+), real SMTP works too, e.g. Gmail with an
# App Password: EMAIL_HOST=smtp.gmail.com / EMAIL_PORT=587 /
# EMAIL_HOST_USER=you@gmail.com / EMAIL_HOST_PASSWORD=<16-char App
# Password, not your account password>. Ignored if RESEND_API_KEY is set.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@smartprocurement.com
